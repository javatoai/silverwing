<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="$(var.ProfileWindowsInstallName)"
           Language="2052"
           Codepage="936"
           Version="$(var.ProductVersion)"
           Manufacturer="Silverwing Contributors"
           UpgradeCode="$(var.ProfileWindowsUpgradeCode)">
    <Package InstallerVersion="500" Platform="x64" Compressed="yes" InstallScope="perUser" Description="Silverwing native desktop application" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer $(var.ProfileWindowsInstallName) version is already installed." />
    <Property Id="NSIS_INSTALLED">
      <RegistrySearch Id="FindSetupInstallation" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\$(var.ProfileWindowsRegistryNamespace)" Name="UninstallString" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="请先卸载 Setup 版本的 $(var.ProfileWindowsInstallName)，再使用 MSI 安装。">Installed OR NOT NSIS_INSTALLED</Condition>
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="$(var.ProfileWindowsInstallName)" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProfileWindowsInstallName)" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcuts" Guid="$(var.ProfileWindowsStartMenuGUID)">
        <Shortcut Id="SilverwingShortcut" Name="$(var.ProfileWindowsInstallName)" Target="[INSTALLFOLDER]$(var.ProfileExecutableName).exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProfileWindowsRegistryNamespace)\Installer" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="$(var.ProfileWindowsDesktopGUID)">
        <Shortcut Id="SilverwingDesktopShortcut" Name="$(var.ProfileWindowsInstallName)" Target="[INSTALLFOLDER]$(var.ProfileExecutableName).exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProfileWindowsRegistryNamespace)\Installer" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallFolderCleanup" Guid="$(var.ProfileWindowsInstallFolderGUID)">
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProfileWindowsRegistryNamespace)\Installer" Name="installFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramsFolder">
      <Component Id="ProgramsFolderCleanup" Guid="$(var.ProfileWindowsProgramsFolderGUID)">
        <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.ProfileWindowsRegistryNamespace)\Installer" Name="programsFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Silverwing" Level="1">
      <ComponentGroupRef Id="SilverwingFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallFolderCleanup" />
      <ComponentRef Id="ProgramsFolderCleanup" />
    </Feature>
  </Product>
</Wix>
